// Slide 100: npm start runs this file, which starts the HTTP server.
// FEATURE: listening at port 3000 (or PORT), independently of route definitions.
const app = require('../app');
const http = require('node:http');

const port = Number(process.env.PORT || 3000);
app.set('port', port);
const server = http.createServer(app);
server.listen(port, '127.0.0.1');

// FEATURE: a readable startup message if another server already uses the port.
server.on('error', (err) => {
  console.error(err.code === 'EADDRINUSE'
    ? `Port ${port} is busy. Stop the other server or set PORT=3001.`
    : err.message);
  process.exitCode = 1;
});

// FEATURE: the "Open http://..." link printed in the terminal after startup.
server.on('listening', () => {
  console.log(`Open http://127.0.0.1:${server.address().port}`);
});

module.exports = server;
